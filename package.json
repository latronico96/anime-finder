{
  "name": "anime-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"next dev\" \"npm:bot:dev\"",
    "bot:dev": "tsx scripts/bot-dev.ts",
    "build": "next build",
    "start": "next start",
    "prod": "npm run build && npm run start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "catalog:split": "tsx scripts/split-naotakus.ts",
    "catalog:process": "tsx scripts/catalog-naotakus.ts",
    "catalog:import": "tsx scripts/import-naotakus.ts"
  },
  "dependencies": {
    "@next/env": "^16.4.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "grammy": "^1.46.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
